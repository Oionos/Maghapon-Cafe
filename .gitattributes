# Line endings in this repository are LF, on every platform.
# Without this file each clone inherits its own core.autocrlf, so a Windows
# checkout and a Linux one disagree about the bytes of every text file — and
# Phase 5's Android toolchain (plus any CI runner) is exactly that second
# platform. The index is already all-LF, so this normalizes nothing: it pins
# the state so a later clone cannot quietly change it.
* text=auto

# Source: LF in the object store and in the working tree
*.astro text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Never converted in either direction
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.png   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary

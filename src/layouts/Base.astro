---
 // Base — shared layout: head, self-hosted fonts, app shell, global controls, footer, cart drawer
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/700.css';
import '@fontsource-variable/geist';
 import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.webp';
import CartDrawer from '../components/CartDrawer.astro';
import CartPanel from '../components/CartPanel.astro';
import Icon from '../components/Icon.astro';

const {
  title = 'Maghapon Café — Filipino Afternoon Coffee Culture',
  description =
    'A coffee spot and communal space in Caloocan, Metro Manila. Coffee, matcha, pastries, and rice bowls — open 2 PM to 11 PM.',
} = Astro.props;
const isAdmin = Astro.url.pathname.startsWith('/admin');
const path = Astro.url.pathname;
const isHome = path === '/';
const isMenu = path === '/menu';
const isBooking = path === '/booking';
const isOrders = path === '/my-orders';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/hero-coffee.jpg" />
    <!-- Phase 1's app shell. Head, not body: the meta it writes is valid head content only, and
         transitionEnabledOnThisPage() queries the whole document, so this is correct-by-spec
         placement rather than a functional requirement. Every route must render it — §4's contract
         item 8 measures a destination without it aborting the swap into a full document load. -->
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="app-shell">
      <!-- Floating global controls: shop status + the single order trigger, top-right, all widths. -->
      {!isAdmin && (
        <div
          class="global-controls"
          id="global-controls"
          transition:persist="global-controls"
        >
          <span class="status-pill global-status" id="status-pill" role="status" aria-label="Shop status: Checking hours…" title="Checking hours…">
            <span class="status-dot" aria-hidden="true"></span>
            <span class="status-text">Checking hours…</span>
          </span>
          <button class="cart-btn order-toggle" id="cart-open" type="button" data-order-toggle aria-controls="cart-panel" aria-expanded="false" aria-label="Open order menu" title="Open order menu">
            <Icon name="shopping-bag" class="cart-icon" size={18} />
            <span class="cart-count" id="cart-count" hidden>0</span>
          </button>
        </div>
      )}
      <!-- Desktop nav rail (≥768px) -->
      <aside
        class="nav-rail"
        id="nav-rail"
        aria-label="Site"
        transition:persist="nav-rail"
      >
        <a class="brand" href="/" aria-label="Maghapon Café home">
          <Image src={logoImg} alt="Maghapon Café logo" width={40} priority />
          <span class="brand-copy">Maghapon Café<small>Caloocan · Metro Manila</small></span>
        </a>
        <nav class="rail-nav" id="rail-navigation" aria-label="Main">
          <a href="/" class={isHome ? 'is-active' : ''} aria-current={isHome ? 'page' : undefined} aria-label="Home" title="Home">
            <Icon name="house" class="rail-icon" size={22} />
            <span class="rail-label">Home</span>
          </a>
          <a href="/menu" class={isMenu ? 'is-active' : ''} aria-current={isMenu ? 'page' : undefined} aria-label="Order" title="Order">
            <Icon name="coffee" class="rail-icon" size={22} />
            <span class="rail-label">Order</span>
          </a>
          <a href="/booking" class={isBooking ? 'is-active' : ''} aria-current={isBooking ? 'page' : undefined} aria-label="Book a table" title="Book a table">
            <Icon name="calendar-blank" class="rail-icon" size={22} />
            <span class="rail-label">Book a table</span>
          </a>
          <a href="/my-orders" class={isOrders ? 'is-active' : ''} aria-current={isOrders ? 'page' : undefined} aria-label="My orders" title="My orders">
            <Icon name="shopping-bag" class="rail-icon" size={22} />
            <span class="rail-label">My orders</span>
          </a>
          <a href="/#rewards" aria-label="Rewards" title="Rewards" data-hash-nav>
            <Icon name="star" class="rail-icon" size={22} />
            <span class="rail-label">Rewards</span>
          </a>
        </nav>
        <div class="rail-footer">
          <button class="rail-toggle" id="rail-toggle" type="button" aria-expanded="true" aria-controls="nav-rail" aria-label="Collapse sidebar" title="Collapse sidebar">
            <svg class="rail-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            <span class="rail-toggle-label">Collapse sidebar</span>
          </button>
        </div>
      </aside>

      <div class="app-main">
        <!-- Sticky admin toolbar: status pill only, never customer order controls (admin unchanged). -->
        {isAdmin && (
          <div class="app-toolbar">
            <span class="status-pill toolbar-status" id="status-pill" role="status" aria-label="Shop status: Checking hours…" title="Checking hours…">
              <span class="status-dot" aria-hidden="true"></span>
              <span class="status-text">Checking hours…</span>
            </span>
          </div>
        )}

        <!-- Mobile compact top bar (≤767px): brand lockup; admin keeps its status pill. -->
        <header class="mobile-topbar" transition:persist="mobile-topbar">
          <a class="brand" href="/" aria-label="Maghapon Café home">
            <Image src={logoImg} alt="Maghapon Café logo" width={32} priority />
            <span class="brand-copy">Maghapon Café</span>
          </a>
          {/* Ruling E: rendered on every route, so the persisted topbar has the same children
              whichever page a swap arrives from; initChromeNav() flips `hidden` per route. */}
          <div class="mobile-topbar-actions" hidden={isAdmin ? undefined : true}>
            <span class="status-pill mobile-status" role="status" aria-label="Shop status: Checking hours…" title="Checking hours…">
              <span class="status-dot" aria-hidden="true"></span>
              <span class="status-text">Checking hours…</span>
            </span>
          </div>
        </header>

        <main id="main-content">
          <slot />
        </main>

        <footer class="site-footer">
          <div class="container">
            <div class="footer-grid">
              <div>
                <div class="footer-brand">
                  <Image src={logoImg} alt="" width={44} loading="lazy" />
                  <strong>Maghapon Café</strong>
                </div>
                <p>
                  Rooted in the Filipino word <em>maghapon</em> — “all day long” — we invite you
                  to take your time over coffee worth staying for.
                </p>
              </div>
              <div>
                <h4>Visit</h4>
                <ul>
                  <li>819 Villa Angelica Subdivision</li>
                  <li>Caloocan, 1422 Metro Manila</li>
                  <li>Open daily, 2 PM – 11 PM (GMT+8)</li>
                </ul>
              </div>
              <div>
                <h4>Connect</h4>
                <ul>
                  <li><a href="mailto:maghaponcafe@gmail.com">maghaponcafe@gmail.com</a></li>
                  <li><a href="/booking">Book a table or rent the space</a></li>
                  <li><a href="/admin">Admin (demo)</a></li>
                </ul>
              </div>
            </div>
            <div class="footer-bottom">
              <span>maghapon coffee house · @maghaponcafe · <a href="#" style="color:inherit;text-decoration:underline;text-underline-offset:3px">Privacy</a> · <a href="#" style="color:inherit;text-decoration:underline;text-underline-offset:3px">Terms</a></span>
              <span>© 2026 Maghapon Café</span>
            </div>
          </div>
        </footer>
      </div>

      {!isAdmin && <CartPanel />}
    </div>

    {!isAdmin && (
      <nav class="tab-bar" aria-label="Primary" transition:persist="tab-bar">
        <a href="/" class={isHome ? 'is-active' : ''} aria-current={isHome ? 'page' : undefined}>
          <Icon name="house" size={22} />
          <span>Home</span>
        </a>
        <a href="/menu" class={isMenu ? 'is-active' : ''} aria-current={isMenu ? 'page' : undefined}>
          <Icon name="coffee" size={22} />
          <span>Menu</span>
        </a>
        <a href="/booking" class={isBooking ? 'is-active' : ''} aria-current={isBooking ? 'page' : undefined}>
          <Icon name="calendar-blank" size={22} />
          <span>Book</span>
        </a>
         <button class="tab-cart" id="cart-open-tab" type="button" data-order-toggle aria-controls="cart-drawer" aria-expanded="false" aria-label="Open order menu" title="Open order menu">
          <span class="tab-icon">
            <Icon name="shopping-bag" size={22} />
            <span class="cart-count" id="cart-count-tab" data-cart-badge hidden>0</span>
          </span>
          <span>Cart</span>
        </button>
      </nav>
    )}

    <CartDrawer />

    <script>
      import {
        boot,
        consumePendingScroll,
        isRouterActive,
        normalizePath,
        requestScrollTo,
        runHooks,
        runPage,
      } from '../lib/nav.js';
      // Static, not dynamic: <ClientRouter /> above already fetches astro's router client, so a
      // dynamic import() here would buy a promise branch in a click handler
      // for zero payload saving.
      // It is safe only because the router is rendered — see Ruling N in the plan.
      import { navigate } from 'astro:transitions/client';

      // ---- Live open/closed status, computed from Manila time (GMT+8) ----
      function tickClock() {
        const pills = document.querySelectorAll('.status-pill');
        if (!pills.length) return;
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'Asia/Manila',
          hour: 'numeric',
          hour12: false,
        }).formatToParts(new Date());
        const hour = Number(parts.find((p) => p.type === 'hour').value);
        const open = hour >= 14 && hour < 23;
        const fullText = open ? 'Open now — closes 11 PM' : 'Closed — opens at 2 PM';
        const isNarrow = window.matchMedia('(max-width: 767px)').matches;
        pills.forEach((pill) => {
          pill.classList.toggle('closed', !open);
          const short = pill.classList.contains('mobile-status') || (pill.classList.contains('global-status') && isNarrow);
          pill.querySelector('.status-text').textContent = short ? (open ? 'Open' : 'Closed') : fullText;
          pill.setAttribute('aria-label', `Shop status: ${fullText}`);
          pill.title = fullText;
        });
      }
      setInterval(tickClock, 60000);

      // ---- Fade-up reveals on scroll (IntersectionObserver, no library) ----
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              io.unobserve(entry.target);
            }
          }),
        { threshold: 0.12 }
      );

      // ---- Shared order-surface coordinator ----
      // The panel and drawer are both rendered once; this coordinator chooses exactly one
      // surface for the current breakpoint instead of allowing controls to stack them.
      // Ruling I: `.app-shell` and `#cart-panel` are looked up on every call and never cached —
      // `#cart-panel` is rendered `{!isAdmin}`, so one trip through /admin replaces the node a
      // cached reference would still be pointing at.
      function shellEl() {
        return document.querySelector('.app-shell');
      }

      function panelEl() {
        return document.getElementById('cart-panel');
      }

      // Ruling F + I: cached, and bound through this same reference (initRailCollapse) so the
      // listener and the aria writes can never point at two different nodes. Safe because
      // `.nav-rail` is one of the six nodes Task 6 gives a stable `transition:persist` key, so a
      // swap hands back this very element. "Renders on every route" alone would not be enough:
      // a swap replaces the body subtree even when every route's markup is identical.
      const railToggle = document.getElementById('rail-toggle');
      const desktopQuery = window.matchMedia('(min-width: 1024px)');
      const railQuery = window.matchMedia('(min-width: 1024px)');
      const panelClose = () => panelEl()?.querySelector('[data-order-close]') ?? null;
      const RAIL_STORAGE_KEY = 'maghapon-rail-collapsed';
      // Rulings G + L: these are the truth. Every class and aria pair on a node is a projection of
      // them, re-derived on arrival by applyPanel()/applyRail() — never read back off the DOM.
      let orderToggles = [];
      let panelOpen = false;
      let drawerOpen = false;
      let panelTrigger = null;
      let railCollapsed = false;

      function usesPanel() {
        return desktopQuery.matches && Boolean(panelEl());
      }

      function syncOrderControls() {
        const drawerIsSurface = drawerOpen;
        const target = drawerIsSurface ? 'cart-drawer' : usesPanel() ? 'cart-panel' : 'cart-drawer';
        const open = drawerIsSurface || (usesPanel() && panelOpen);
        orderToggles.forEach((toggle) => {
          toggle.setAttribute('aria-controls', target);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close order menu' : 'Open order menu');
          toggle.title = open ? 'Close order menu' : 'Open order menu';
        });
      }

      function applyPanel() {
        const shell = shellEl();
        const panel = panelEl();
        if (!shell) return;
        // panelOpen is the truth; the class and aria pair are its projections onto nodes that a
        // swap may have just replaced. Skipping this is the inverted-toggle defect Ruling L names.
        // This is the only writer of #cart-panel's aria-hidden: a second one that used `!panelOpen`
        // instead of `!on` would claim the panel is visible below the breakpoint that hides it.
        const on = panelOpen && usesPanel() && Boolean(panel);
        shell.classList.toggle('cart-panel-open', on);
        panel?.setAttribute('aria-hidden', String(!on));
      }

      function setPanelOpen(next, trigger = null) {
        if (!shellEl() || !panelEl() || !usesPanel()) {
          panelOpen = false;
          applyPanel();
          syncOrderControls();
          return;
        }
        panelOpen = next;
        if (next && trigger) panelTrigger = trigger;
        applyPanel();
        syncOrderControls();
        if (next) {
          window.requestAnimationFrame(() => panelClose()?.focus());
        } else if (panelTrigger?.isConnected) {
          panelTrigger.focus();
        }
      }

      function handleOrderToggle(event) {
        const trigger = event.currentTarget;
        if (usesPanel() && !drawerOpen) {
          setPanelOpen(!panelOpen, trigger);
          return;
        }
        if (usesPanel() && drawerOpen) {
          window.dispatchEvent(new CustomEvent('maghapon:cart-close'));
          return;
        }
        window.dispatchEvent(new CustomEvent('maghapon:cart-toggle', { detail: { trigger } }));
      }

      document.addEventListener('click', (event) => {
        if (event.target.closest('[data-order-close]')) setPanelOpen(false);
      });
      window.addEventListener('maghapon:drawer-state', (event) => {
        drawerOpen = event.detail?.open === true;
        if (drawerOpen) setPanelOpen(false);
        syncOrderControls();
      });

      function syncRailToggle() {
        const shell = shellEl();
        if (!railToggle || !shell) return;
        const collapsed = shell.classList.contains('rail-collapsed');
        railToggle.setAttribute('aria-expanded', String(!collapsed));
        railToggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
        railToggle.title = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
      }

      function storedRailPreference() {
        try {
          return localStorage.getItem(RAIL_STORAGE_KEY) === 'true';
        } catch {
          return false;
        }
      }

      function applyRail() {
        const shell = shellEl();
        if (!shell) return;
        shell.classList.toggle('rail-collapsed', railQuery.matches && railCollapsed);
        syncRailToggle();
      }

      function setRailCollapsed(next, persist = true) {
        railCollapsed = Boolean(next);
        if (persist && railQuery.matches) {
          localStorage.setItem(RAIL_STORAGE_KEY, String(railCollapsed));
        }
        applyRail();
      }

      const onDesktopBreakpointChange = () => {
        if (usesPanel()) {
          window.dispatchEvent(new CustomEvent('maghapon:cart-close'));
        }
        setPanelOpen(false);
        syncOrderControls();
      };
      const onRailBreakpointChange = applyRail;
      desktopQuery.addEventListener('change', onDesktopBreakpointChange);
      railQuery.addEventListener('change', onRailBreakpointChange);

      // ---- Per-arrival initialisers ----
      // Every binding that touches a node lives here, guarded by a subsystem-named data-bound flag,
      // because one node can host two subsystems (#cart-open is an order toggle AND the badge
      // source) and because a swap can hand any of them back as a brand-new element.
      function initOverlayState() {
        // Ruling M: <body> is the node the router replaces, so the modal scroll lock — set at
        // CartDrawer.astro:64/:72 — does not survive a swap, while the drawer's own .open class
        // does. Re-assert the lock from the one truth the shell already keeps, and refuse to carry
        // an open customer drawer into /admin, which today always loads closed.
        if (drawerOpen && normalizePath(location.pathname) === '/admin') {
          // Synchronous: the drawer's listener flips drawerOpen before this line returns, so the
          // assignment below reads settled truth. Not returning also covers the case closeDrawer()
          // early-returns on (CartDrawer.astro:71) — the lock then stays asserted, matching the
          // truth the shell keeps, instead of being left to whatever the DOM happened to hold.
          window.dispatchEvent(new CustomEvent('maghapon:cart-close'));
        }
        document.body.style.overflow = drawerOpen ? 'hidden' : '';
      }

      function initStatusPill() {
        tickClock();
      }

      // Ruling E: nav state is derived per arrival instead of baked into each route's markup,
      // because a persisted node keeps the DOM the first route wrote — so the highlight a swap
      // leaves behind is whatever that route rendered. Server-rendered class/aria-current stay,
      // so no-JS still gets a correct highlight; this function has the last word when JS runs.
      function initChromeNav() {
        const path = normalizePath(location.pathname);
        document.querySelectorAll('.rail-nav a[href], .tab-bar a[href]').forEach((link) => {
          const url = new URL(link.href, location.href);
          const active = !url.hash && normalizePath(url.pathname) === path;
          link.classList.toggle('is-active', active);
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
        const actions = document.querySelector('.mobile-topbar-actions');
        if (actions) actions.hidden = path !== '/admin';
      }

      function initReveals() {
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }

      function initOrderSurface() {
        orderToggles = [...document.querySelectorAll('[data-order-toggle]')];
        orderToggles.forEach((toggle) => {
          if (toggle.dataset.orderBound) return;
          toggle.dataset.orderBound = '1';
          toggle.addEventListener('click', handleOrderToggle);
        });
        applyPanel();
        syncOrderControls();
      }

      function initRailCollapse() {
        if (!railToggle) return;
        if (!railToggle.dataset.railBound) {
          railToggle.dataset.railBound = '1';
          railToggle.addEventListener('click', () => setRailCollapsed(!railCollapsed));
        }
        applyRail();
      }

      // ---- Mirror the cart badge to the mobile buttons ----
      // CartDrawer updates #cart-count (global controls); keep the mobile badges in sync.
      function initBadgeMirror() {
        const badge = document.getElementById('cart-count');
        if (!badge) return;
        const sync = () => {
          // Re-queried per call, never captured: this observer is installed once (badgeBound) and a
          // swap can hand back brand-new [data-cart-badge] nodes, so a captured list would keep
          // writing to detached mirrors and the live badge would go silently stale.
          document.querySelectorAll('[data-cart-badge]').forEach((m) => {
            m.textContent = badge.textContent;
            m.hidden = badge.hidden;
          });
        };
        sync();
        if (!badge.dataset.badgeBound) {
          badge.dataset.badgeBound = '1';
          new MutationObserver(sync).observe(badge, {
            attributes: true,
            childList: true,
            subtree: true,
          });
        }
      }

      function initPageScripts() {
        runHooks();
        runPage(location.pathname);
      }

      // The rail's Rewards anchor is the one link in the chrome whose destination is `/` plus a
      // fragment. With the router on, a browser-native hash jump across pages is a full navigation
      // (which would drop the app shell), so the click is converted into a swap and the scroll is
      // handed to the arrival that follows it. `requestScrollTo()` must come *before* `navigate()`,
      // because arrive() runs during it and consumes whatever is queued. A same-page click returns
      // early and the browser scrolls on its own. The `isRouterActive` guard is not dead weight for
      // a future web build: §4's contract item 8 measures a route that fails to render the router
      // turning the swap into a full document load — this is what keeps the handler honest there.
      function initHashNav() {
        document.querySelectorAll('[data-hash-nav]').forEach((link) => {
          if (link.dataset.hashBound) return;
          link.dataset.hashBound = '1';
          link.addEventListener('click', (event) => {
            if (!isRouterActive(document)) return;
            const url = new URL(link.href, location.href);
            if (normalizePath(url.pathname) === normalizePath(location.pathname)) return;
            event.preventDefault();
            requestScrollTo(url.hash.slice(1));
            navigate(url.pathname);
          });
        });
      }

      function arrive() {
        initOverlayState();
        initStatusPill();
        initChromeNav();
        initReveals();
        initOrderSurface();
        initRailCollapse();
        initBadgeMirror();
        initPageScripts();
        consumePendingScroll();
        initHashNav();
      }

      window.maghaponShell = {
        arrive,
        get drawerOpen() {
          return drawerOpen;
        },
        get panelOpen() {
          return panelOpen;
        },
      };

      // Ruling G: read the stored preference once, never on arrival — re-reading it would snap the
      // rail back to storage every time the user collapses it and then navigates.
      railCollapsed = storedRailPreference();
      boot(arrive);
    </script>
  </body>
</html>

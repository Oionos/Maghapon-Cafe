---
 // Base — shared layout: head, self-hosted fonts, app shell, global controls, footer, cart drawer
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
 import '../styles/global.css';
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.webp';
import CartDrawer from '../components/CartDrawer.astro';
import CartPanel from '../components/CartPanel.astro';
import Icon from '../components/Icon.astro';

const {
  title = 'Maghapon Café — Filipino Afternoon Coffee Culture',
  description =
    'A coffee spot and communal space in Caloocan, Metro Manila. Coffee, matcha, pastries, and rice bowls — open 2 PM to 11 PM.',
} = Astro.props;
const isAdmin = Astro.url.pathname.startsWith('/admin');
const path = Astro.url.pathname;
const isHome = path === '/';
const isMenu = path === '/menu';
const isBooking = path === '/booking';
const isOrders = path === '/my-orders';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/hero-coffee.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Geist for body — fixes Inter-everywhere generic (audit) while keeping Fraunces for display -->
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1"></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="app-shell">
      <!-- Floating global controls: shop status + the single order trigger, top-right, all widths. -->
      {!isAdmin && (
        <div class="global-controls" id="global-controls">
          <span class="status-pill global-status" id="status-pill" role="status" aria-label="Shop status: Checking hours…" title="Checking hours…">
            <span class="status-dot" aria-hidden="true"></span>
            <span class="status-text">Checking hours…</span>
          </span>
          <button class="cart-btn order-toggle" id="cart-open" type="button" data-order-toggle aria-controls="cart-panel" aria-expanded="false" aria-label="Open order menu" title="Open order menu">
            <Icon name="shopping-bag" class="cart-icon" size={18} />
            <span class="cart-count" id="cart-count" hidden>0</span>
          </button>
        </div>
      )}
      <!-- Desktop nav rail (≥768px) -->
      <aside class="nav-rail" id="nav-rail" aria-label="Site">
        <a class="brand" href="/" aria-label="Maghapon Café home">
          <Image src={logoImg} alt="Maghapon Café logo" width={40} priority />
          <span class="brand-copy">Maghapon Café<small>Caloocan · Metro Manila</small></span>
        </a>
        <nav class="rail-nav" id="rail-navigation" aria-label="Main">
          <a href="/" class={isHome ? 'is-active' : ''} aria-current={isHome ? 'page' : undefined} aria-label="Home" title="Home">
            <Icon name="house" class="rail-icon" size={22} />
            <span class="rail-label">Home</span>
          </a>
          <a href="/menu" class={isMenu ? 'is-active' : ''} aria-current={isMenu ? 'page' : undefined} aria-label="Order" title="Order">
            <Icon name="coffee" class="rail-icon" size={22} />
            <span class="rail-label">Order</span>
          </a>
          <a href="/booking" class={isBooking ? 'is-active' : ''} aria-current={isBooking ? 'page' : undefined} aria-label="Book a table" title="Book a table">
            <Icon name="calendar-blank" class="rail-icon" size={22} />
            <span class="rail-label">Book a table</span>
          </a>
          <a href="/my-orders" class={isOrders ? 'is-active' : ''} aria-current={isOrders ? 'page' : undefined} aria-label="My orders" title="My orders">
            <Icon name="shopping-bag" class="rail-icon" size={22} />
            <span class="rail-label">My orders</span>
          </a>
          <a href="/#rewards" aria-label="Rewards" title="Rewards">
            <Icon name="star" class="rail-icon" size={22} />
            <span class="rail-label">Rewards</span>
          </a>
        </nav>
        <div class="rail-footer">
          <button class="rail-toggle" id="rail-toggle" type="button" aria-expanded="true" aria-controls="nav-rail" aria-label="Collapse sidebar" title="Collapse sidebar">
            <svg class="rail-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            <span class="rail-toggle-label">Collapse sidebar</span>
          </button>
        </div>
      </aside>

      <div class="app-main">
        <!-- Sticky admin toolbar: status pill only, never customer order controls (admin unchanged). -->
        {isAdmin && (
          <div class="app-toolbar">
            <span class="status-pill toolbar-status" id="status-pill" role="status" aria-label="Shop status: Checking hours…" title="Checking hours…">
              <span class="status-dot" aria-hidden="true"></span>
              <span class="status-text">Checking hours…</span>
            </span>
          </div>
        )}

        <!-- Mobile compact top bar (≤767px): brand lockup; admin keeps its status pill. -->
        <header class="mobile-topbar">
          <a class="brand" href="/" aria-label="Maghapon Café home">
            <Image src={logoImg} alt="Maghapon Café logo" width={32} priority />
            <span class="brand-copy">Maghapon Café</span>
          </a>
          {isAdmin && (
            <div class="mobile-topbar-actions">
              <span class="status-pill mobile-status" role="status" aria-label="Shop status: Checking hours…" title="Checking hours…">
                <span class="status-dot" aria-hidden="true"></span>
                <span class="status-text">Checking hours…</span>
              </span>
            </div>
          )}
        </header>

        <main id="main-content">
          <slot />
        </main>

        <footer class="site-footer">
          <div class="container">
            <div class="footer-grid">
              <div>
                <div class="footer-brand">
                  <Image src={logoImg} alt="" width={44} loading="lazy" />
                  <strong>Maghapon Café</strong>
                </div>
                <p>
                  Rooted in the Filipino word <em>maghapon</em> — “all day long” — we invite you
                  to take your time over coffee worth staying for.
                </p>
              </div>
              <div>
                <h4>Visit</h4>
                <ul>
                  <li>819 Villa Angelica Subdivision</li>
                  <li>Caloocan, 1422 Metro Manila</li>
                  <li>Open daily, 2 PM – 11 PM (GMT+8)</li>
                </ul>
              </div>
              <div>
                <h4>Connect</h4>
                <ul>
                  <li><a href="mailto:maghaponcafe@gmail.com">maghaponcafe@gmail.com</a></li>
                  <li><a href="/booking">Book a table or rent the space</a></li>
                  <li><a href="/admin">Admin (demo)</a></li>
                </ul>
              </div>
            </div>
            <div class="footer-bottom">
              <span>maghapon coffee house · @maghaponcafe · <a href="#" style="color:inherit;text-decoration:underline;text-underline-offset:3px">Privacy</a> · <a href="#" style="color:inherit;text-decoration:underline;text-underline-offset:3px">Terms</a></span>
              <span>© 2026 Maghapon Café</span>
            </div>
          </div>
        </footer>
      </div>

      {!isAdmin && <CartPanel />}
    </div>

    {!isAdmin && (
      <nav class="tab-bar" aria-label="Primary">
        <a href="/" class={isHome ? 'is-active' : ''} aria-current={isHome ? 'page' : undefined}>
          <Icon name="house" size={22} />
          <span>Home</span>
        </a>
        <a href="/menu" class={isMenu ? 'is-active' : ''} aria-current={isMenu ? 'page' : undefined}>
          <Icon name="coffee" size={22} />
          <span>Menu</span>
        </a>
        <a href="/booking" class={isBooking ? 'is-active' : ''} aria-current={isBooking ? 'page' : undefined}>
          <Icon name="calendar-blank" size={22} />
          <span>Book</span>
        </a>
         <button class="tab-cart" id="cart-open-tab" type="button" data-order-toggle aria-controls="cart-drawer" aria-expanded="false" aria-label="Open order menu" title="Open order menu">
          <span class="tab-icon">
            <Icon name="shopping-bag" size={22} />
            <span class="cart-count" id="cart-count-tab" data-cart-badge hidden>0</span>
          </span>
          <span>Cart</span>
        </button>
      </nav>
    )}

    <CartDrawer />

    <script>
      // ---- Live open/closed status, computed from Manila time (GMT+8) ----
      function tickClock() {
        const pills = document.querySelectorAll('.status-pill');
        if (!pills.length) return;
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'Asia/Manila',
          hour: 'numeric',
          hour12: false,
        }).formatToParts(new Date());
        const hour = Number(parts.find((p) => p.type === 'hour').value);
        const open = hour >= 14 && hour < 23;
        const fullText = open ? 'Open now — closes 11 PM' : 'Closed — opens at 2 PM';
        const isNarrow = window.matchMedia('(max-width: 767px)').matches;
        pills.forEach((pill) => {
          pill.classList.toggle('closed', !open);
          const short = pill.classList.contains('mobile-status') || (pill.classList.contains('global-status') && isNarrow);
          pill.querySelector('.status-text').textContent = short ? (open ? 'Open' : 'Closed') : fullText;
          pill.setAttribute('aria-label', `Shop status: ${fullText}`);
          pill.title = fullText;
        });
      }
      tickClock();
      setInterval(tickClock, 60000);

      // ---- Fade-up reveals on scroll (IntersectionObserver, no library) ----
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              io.unobserve(entry.target);
            }
          }),
        { threshold: 0.12 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // ---- Shared order-surface coordinator ----
      // The panel and drawer are both rendered once; this coordinator chooses exactly one
      // surface for the current breakpoint instead of allowing controls to stack them.
      const shell = document.querySelector('.app-shell');
      const panel = document.getElementById('cart-panel');
      const railToggle = document.getElementById('rail-toggle');
      const orderToggles = [...document.querySelectorAll('[data-order-toggle]')];
      const desktopQuery = window.matchMedia('(min-width: 1024px)');
      const railQuery = window.matchMedia('(min-width: 1024px)');
      const panelClose = panel?.querySelector('[data-order-close]');
      const RAIL_STORAGE_KEY = 'maghapon-rail-collapsed';
      let panelOpen = false;
      let drawerOpen = false;
      let panelTrigger = null;

      function usesPanel() {
        return desktopQuery.matches && Boolean(panel);
      }

      function syncOrderControls() {
        const drawerIsSurface = drawerOpen;
        const target = drawerIsSurface ? 'cart-drawer' : usesPanel() ? 'cart-panel' : 'cart-drawer';
        const open = drawerIsSurface || (usesPanel() && panelOpen);
        orderToggles.forEach((toggle) => {
          toggle.setAttribute('aria-controls', target);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close order menu' : 'Open order menu');
          toggle.title = open ? 'Close order menu' : 'Open order menu';
        });
        if (panel) panel.setAttribute('aria-hidden', String(!panelOpen));
      }

      function setPanelOpen(next, trigger = null) {
        if (!shell || !panel || !usesPanel()) {
          panelOpen = false;
          shell?.classList.remove('cart-panel-open');
          syncOrderControls();
          return;
        }
        panelOpen = next;
        if (next && trigger) panelTrigger = trigger;
        shell.classList.toggle('cart-panel-open', next);
        panel.setAttribute('aria-hidden', String(!next));
        syncOrderControls();
        if (next) {
          window.requestAnimationFrame(() => panelClose?.focus());
        } else if (panelTrigger?.isConnected) {
          panelTrigger.focus();
        }
      }

      function handleOrderToggle(event) {
        const trigger = event.currentTarget;
        if (usesPanel() && !drawerOpen) {
          setPanelOpen(!panelOpen, trigger);
          return;
        }
        if (usesPanel() && drawerOpen) {
          window.dispatchEvent(new CustomEvent('maghapon:cart-close'));
          return;
        }
        window.dispatchEvent(new CustomEvent('maghapon:cart-toggle', { detail: { trigger } }));
      }

      orderToggles.forEach((toggle) => toggle.addEventListener('click', handleOrderToggle));
      document.addEventListener('click', (event) => {
        if (event.target.closest('[data-order-close]')) setPanelOpen(false);
      });
      window.addEventListener('maghapon:drawer-state', (event) => {
        drawerOpen = event.detail?.open === true;
        if (drawerOpen) setPanelOpen(false);
        syncOrderControls();
      });

      function syncRailToggle() {
        if (!railToggle || !shell) return;
        const collapsed = shell.classList.contains('rail-collapsed');
        railToggle.setAttribute('aria-expanded', String(!collapsed));
        railToggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
        railToggle.title = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
      }

      function storedRailPreference() {
        try {
          return localStorage.getItem(RAIL_STORAGE_KEY) === 'true';
        } catch {
          return false;
        }
      }

      function setRailCollapsed(next, persist = true) {
        if (!shell) return;
        const collapsed = railQuery.matches && next;
        shell.classList.toggle('rail-collapsed', collapsed);
        if (persist && railQuery.matches) localStorage.setItem(RAIL_STORAGE_KEY, String(collapsed));
        syncRailToggle();
      }

      setRailCollapsed(storedRailPreference(), false);
      railToggle?.addEventListener('click', () => {
        setRailCollapsed(!shell.classList.contains('rail-collapsed'));
      });

      const onDesktopBreakpointChange = () => {
        if (usesPanel()) {
          window.dispatchEvent(new CustomEvent('maghapon:cart-close'));
        }
        setPanelOpen(false);
        syncOrderControls();
      };
      const onRailBreakpointChange = () => setRailCollapsed(storedRailPreference(), false);
      desktopQuery.addEventListener('change', onDesktopBreakpointChange);
      railQuery.addEventListener('change', onRailBreakpointChange);
      syncOrderControls();

      // ---- Mirror the cart badge to the mobile buttons ----
      // CartDrawer updates #cart-count (global controls); keep the mobile badges in sync.
      const badge = document.getElementById('cart-count');
      const mirrors = document.querySelectorAll('[data-cart-badge]');
      if (badge && mirrors.length) {
        const sync = () => {
          mirrors.forEach((m) => {
            m.textContent = badge.textContent;
            m.hidden = badge.hidden;
          });
        };
        sync();
        new MutationObserver(sync).observe(badge, { attributes: true, childList: true, subtree: true });
      }
    </script>
  </body>
</html>

---
// Admin — demo order dashboard (this browser's store only, no auth, no backend)
import Base from '../layouts/Base.astro';
---
<Base
  title="Orders — Maghapon Café Admin"
  description="Demo order dashboard for Maghapon Café."
>
  <div class="admin-banner" role="note">DEMO — no auth, no backend. Orders live in this browser only.</div>

  <div class="container admin-head">
    <div>
      <span class="eyebrow">Maghapon Café</span>
      <h1>Orders</h1>
    </div>
    <div class="admin-stats" id="admin-stats"></div>
  </div>

  <div class="container" id="orders-list"></div>

  <div class="container admin-bookings">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Requests</span>
      <h2>Bookings</h2>
      <p>Table reservations and space rentals sent from the landing page.</p>
    </div>
    <div id="bookings-list"></div>
  </div>

  <script>
    import {
      listOrders,
      seedOrders,
      updateOrderStatus,
      listBookings,
    } from '../lib/store/orderStore.js';

    const STATUSES = ['Received', 'Preparing', 'Ready', 'Served'];
    const SEED = {
      id: 'MAG-1001',
      customer: { name: 'Mia', phone: '0917 000 0000' },
      type: 'Pickup',
      items: [
        { name: 'Sea Salt Cloud Latte', variant: 'Iced 16oz', modifiers: [], qty: 2, unit: 170 },
        { name: 'Salted Choco Chip Cookie', variant: null, modifiers: [], qty: 1, unit: 130 },
      ],
      total: 470,
      status: 'Received',
      createdAt: new Date().toISOString(),
    };

    function esc(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    function manilaTime(iso) {
      return new Date(iso).toLocaleString('en-PH', {
        timeZone: 'Asia/Manila',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    }
    function getOrders() {
      let orders = listOrders();
      if (orders.length === 0) {
        orders = [SEED];
        seedOrders(orders);
      }
      return orders;
    }

    function render() {
      const orders = getOrders();
      const counts = {};
      STATUSES.forEach((s) => (counts[s] = 0));
      orders.forEach((o) => (counts[o.status] = (counts[o.status] || 0) + 1));
      document.getElementById('admin-stats').innerHTML = STATUSES.map(
        (s) => `<div class="admin-stat"><b>${counts[s]}</b><span>${s}</span></div>`
      ).join('');

      const list = document.getElementById('orders-list');
      if (orders.length === 0) {
        list.innerHTML = '<div class="admin-empty">No orders yet — the pipeline starts when a customer checks out.</div>';
      } else {
        list.innerHTML = orders
          .map(
            (o) => `
            <article class="order-card" data-order="${esc(o.id)}">
              <div class="order-head">
                <span class="order-number">${esc(o.id)}</span>
                <span class="order-time">${esc(manilaTime(o.createdAt))}</span>
              </div>
              <div class="order-meta">${esc(o.customer.name)} · ${esc(o.customer.phone)} · ${esc(o.type)}</div>
              <div class="order-items">
                ${o.items
                  .map(
                    (i) => `<div class="order-item">
                      <span>${i.qty}× ${esc(i.name)}${i.variant ? ' (' + esc(i.variant) + ')' : ''}${i.modifiers && i.modifiers.length ? ' <small>+ ' + esc(i.modifiers.join(', ')) + '</small>' : ''}</span>
                      <span>₱${i.unit * i.qty}</span>
                    </div>`
                  )
                  .join('')}
              </div>
              <div class="order-total"><span>Total</span><b>₱${o.total}</b></div>
              <div class="pipeline">
                ${STATUSES.map(
                  (s) => `<span class="pipe-step ${s === o.status ? 'active' : ''}">${s}</span>`
                ).join('')}
                ${o.status === 'Served'
                  ? '<span class="pipe-done">Done ✓</span>'
                  : `<button class="btn btn-primary btn-sm" data-advance="${esc(o.id)}">Advance to ${STATUSES[STATUSES.indexOf(o.status) + 1]}</button>`}
              </div>
            </article>`
          )
          .join('');
        list.querySelectorAll('[data-advance]').forEach((btn) =>
          btn.addEventListener('click', () => {
            const o = getOrders().find((x) => x.id === btn.dataset.advance);
            const next = o && STATUSES[STATUSES.indexOf(o.status) + 1];
            if (next && updateOrderStatus(o.id, next)) render();
          })
        );
      }

      const bookings = listBookings();
      const bList = document.getElementById('bookings-list');
      if (bookings.length === 0) {
        bList.innerHTML = '<div class="admin-empty">No booking requests yet.</div>';
      } else {
        bList.innerHTML = bookings
          .map(
            (b) => `
            <div class="booking-row">
              <div>
                <strong>${esc(b.name)}</strong>
                <span>${esc(b.phone)}</span>
              </div>
              <div>
                <strong>${esc(b.date)} · ${esc(b.time)}</strong>
                <span>${b.guests} guest${b.guests === 1 ? '' : 's'} · ${esc(b.eventType)}</span>
              </div>
            </div>`
          )
          .join('');
      }
    }

    render();
    // Live updates: orders placed in ANOTHER tab of this browser appear here
    window.addEventListener('storage', render);
    window.addEventListener('focus', render);
  </script>
</Base>
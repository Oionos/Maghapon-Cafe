---
// MenuCard — one menu item: placeholder art, badges, price chips, add-to-cart
// compact: dense card for the landing ordering grid (price line + circle add button, no description)
// reveal: false disables the scroll-reveal so first-screen cards render instantly
// hidden: passthrough so the landing grid can pre-hide non-featured items
// image: product photo — astro:assets metadata (rendered as optimized <Image>) or URL string
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

const { item, interactive = true, compact = false, reveal = true, hidden = false, image = null } = Astro.props;
const initial = item.name.charAt(0).toUpperCase();
const searchText = (item.name + ' ' + item.description).toLowerCase();
const prices = item.variants.map((v) => v.price);
const min = Math.min(...prices);
const max = Math.max(...prices);
const priceText = min === max ? `₱${min}` : `₱${min}–₱${max}`;
const isMatcha = item.category === 'Matcha' || item.name.toLowerCase().includes('matcha');
---
<article
  class={compact ? 'menu-card menu-card-compact' : 'menu-card'}
  data-reveal={reveal ? '' : undefined}
  hidden={hidden || undefined}
  data-id={item.id}
  data-category={item.category}
  data-search={searchText}
>
  <div class="menu-card-media" aria-hidden="true">
    {image ? (
      typeof image === 'string' ? (
        <img src={image} alt={item.name} loading="lazy" class="menu-card-photo" />
      ) : (
        <Image src={image} alt={item.name} width={640} loading="lazy" class="menu-card-photo" />
      )
    ) : (
      <span class="menu-card-initial">{initial}</span>
    )}
    {item.limited && <span class="badge badge-limited">Limited</span>}
    {item.seasonal && <span class="badge badge-seasonal">Seasonal</span>}
    {isMatcha && <span class="badge badge-matcha">Matcha</span>}
    {item.featured && <span class="badge badge-star">★</span>}
  </div>
  <div class="menu-card-body">
    <h3>{item.name}</h3>
    {!compact && <p>{item.description}</p>}
    {compact ? (
      <div class="compact-row">
        <span class="compact-price">{priceText}</span>
        <button class="add-btn" type="button" data-add={item.id} aria-label={`Add ${item.name} to cart`}>
          <Icon name="plus" size={18} />
        </button>
      </div>
    ) : (
      <>
        <div class="price-row">
          {item.variants.map((variant) => (
            <span class="price-chip">
              {variant.label && <span class="price-size">{variant.label}</span>}
              <b>₱{variant.price}</b>
            </span>
          ))}
        </div>
        {interactive ? (
          <button class="btn btn-primary btn-sm" type="button" data-add={item.id}>Add to cart <span class="btn-icon"><Icon name="plus" size={14} /></span></button>
        ) : (
          <a class="btn btn-ghost btn-sm" href="/menu">On the menu</a>
        )}
      </>
    )}
  </div>
</article>